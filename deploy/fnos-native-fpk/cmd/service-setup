#!/bin/bash
# 原生 FPK 服务声明：直接执行包内静态二进制。
# 参考 fnos-apps/apps/gopeed/fnos/cmd/service-setup 与官方 cmd/main 示例（./myapp &）。
# 不声明 install_dep_apps、不建 venv、不改 PATH —— 安装与启动全程离线。

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"
BIN="${TRIM_APPDEST}/bin/hosts-optimizer"

mkdir -p "${TRIM_PKGVAR}/output" "${TRIM_PKGVAR}/state"

# 用户可见的应用数据目录（config/resource 的 data-share，文件管理器可访问）：
# 存放 admin-token 与 logs/app.log。TRIM_DATA_SHARE_PATHS 为冒号分隔列表，取首段；
# 平台未注入时回退到 share 软链路径。
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "$DATA_DIR" ]; then
  DATA_DIR="/var/apps/${TRIM_APPNAME}/share/data"
fi
mkdir -p "${DATA_DIR}/logs"

# 所有路径通过 HO_* 注入，不硬编码 /volN。
# 变量显式写进 SERVICE_COMMAND 而不是只做 export：该命令由平台另起 shell 执行，
# 显式注入不依赖 service-setup 的 source 作用域（Gopeed 实证也是把一切写进命令）。
# HO_CONFIG 指向用户可见共享目录根：domains.json 落在这里，可在文件管理器查看/编辑/备份。
# HO_LEGACY_CONFIG 指向旧配置目录，启动时若主路径缺失则一次性迁移旧 domains.json。
# 不再注入 HO_CA_BUNDLE：包内不携带 ca-bundle.crt，二进制会回落到系统证书池
# （已在真机验证可对 github.com / raw.githubusercontent.com 完成 TLS 校验）。
SERVICE_COMMAND="env HO_CONFIG=${DATA_DIR} HO_LEGACY_CONFIG=${TRIM_PKGETC} HO_OUTPUT=${TRIM_PKGVAR}/output HO_STATE=${TRIM_PKGVAR}/state HO_DATA=${DATA_DIR} HO_PORT=${TRIM_SERVICE_PORT} HO_TZ=Asia/Shanghai ${BIN}"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

service_preuninst() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
}

service_poststop() {
  service_preuninst
}
