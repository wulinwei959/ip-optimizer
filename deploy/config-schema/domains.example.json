{
  "_readme": "手动新增域名：在 domains 数组中追加对象即可；保存后下一轮自动生成，也可 POST /refresh 即时刷新。要让 IP 切换在一个 TTL 内生效，把 defaults.dns.listen 对应的分流规则粘到 AdGuard Home「上游 DNS 服务器」（与过滤器订阅二选一）。本文件为 JSON，不支持注释，字段说明见 deploy/config-schema/README.md",
  "domains": [
    { "name": "github.com" },
    {
      "name": "raw.githubusercontent.com",
      "sni": "raw.githubusercontent.com",
      "port": 443
    },
    {
      "name": "gitlab.com",
      "expand": true,
      "expand_sources": ["wordlist", "rules"]
    },
    {
      "name": "cloudflare.com",
      "expand": true,
      "expand_sources": ["ct", "wordlist", "rules"]
    }
  ],
  "defaults": {
    "schedule_minutes": 60,
    "probe_dns": ["223.5.5.5", "119.29.29.29"],
    "probe_port": 443,
    "concurrency": 20,
    "hysteresis_percent": 20,
    "hysteresis_rounds": 2,
    "max_candidates": 64,
    "tcp_rounds": 3,
    "timeout_seconds": 3,
    "probe_top_n": 5,
    "probe_full_every": 6,
    "watch_interval_seconds": 60,
    "watch_switch_percent": 100,
    "expand_concurrency": 10,
    "expand_timeout_seconds": 10,
    "expand_max_subdomains": 50,
    "expand_sources": ["wordlist", "rules"],
    "history_retention_months": 12,
    "dns": {
      "listen": "127.0.0.1:18053",
      "ttl": 60
    }
  }
}
